{
  "info": {
    "name": "Digital Signature API",
    "description": "Complete API collection for Digital Signature application",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "http://localhost:5000/api/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"confirmPassword\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "http://localhost:5000/api/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "Upload Document",
          "request": {
            "method": "POST",
            "url": "http://localhost:5000/api/documents/upload",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "path/to/your/file.pdf"
                }
              ]
            }
          }
        },
        {
          "name": "Get All Documents",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/documents",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Get Document by ID",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/documents/{{documentId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Download Document",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/documents/{{documentId}}/download",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Signatures",
      "item": [
        {
          "name": "Save Signature",
          "request": {
            "method": "POST",
            "url": "http://localhost:5000/api/signatures",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentId\": \"{{documentId}}\",\n  \"coordinates\": {\n    \"x\": 100,\n    \"y\": 100,\n    \"page\": 1\n  },\n  \"signatureText\": \"Signed by John Doe\",\n  \"signatureImage\": \"data:image/png;base64,...\"\n}"
            }
          }
        },
        {
          "name": "Get Signatures for Document",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/signatures/{{documentId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Update Signature Status",
          "request": {
            "method": "PATCH",
            "url": "http://localhost:5000/api/signatures/{{signatureId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"signed\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Audit Trail",
      "item": [
        {
          "name": "Get Document Audit Trail",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/audit/{{documentId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Get User Audit Trail",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/audit/user/trail",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "http://localhost:5000/api/health"
      }
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "documentId",
      "value": ""
    },
    {
      "key": "signatureId",
      "value": ""
    }
  ]
}
